@page "/estudiantes"
@rendermode InteractiveServer
@using SistemaAula.Blazor.Models
@using SistemaAula.Blazor.Services
@inject EstudianteApiService EstudianteService

<h3 class="mb-4">Gestión de Estudiantes</h3>

<div class="card p-3 mb-4 shadow-sm">
    <h5>@(modoEdicion ? "Editar Estudiante" : "Registrar Nuevo Estudiante")</h5>
    <div class="row g-2">
        <div class="col-md-3">
            <input class="form-control" placeholder="Nombre" @bind="estudianteActual.Nombre" />
        </div>
        <div class="col-md-3">
            <input class="form-control" placeholder="Apellido" @bind="estudianteActual.Apellido" />
        </div>
        <div class="col-md-3">
            <input class="form-control" placeholder="Matrícula" @bind="estudianteActual.Matricula" />
        </div>
        <div class="col-md-3">
            <input type="email" class="form-control" placeholder="Correo Electrónico" @bind="estudianteActual.Email" />
        </div>
        <div class="col-12 mt-2 text-end">
            @if (modoEdicion)
            {
                <button class="btn btn-secondary me-2" @onclick="CancelarEdicion">Cancelar</button>
                <button class="btn btn-success" @onclick="Guardar">Actualizar</button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="Guardar">Guardar</button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger mt-3 mb-0">@mensajeError</div>
    }
</div>

<h5>Estudiantes Registrados</h5>
@if (lista == null)
{
    <p>Cargando registros...</p>
}
else if (lista.Count == 0)
{
    <div class="alert alert-warning">No hay estudiantes registrados.</div>
}
else
{
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Matrícula</th>
                <th>Email</th>
                <th style="width: 180px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var est in lista)
            {
                <tr>
                    <td>@est.Id</td>
                    <td>@est.Nombre</td>
                    <td>@est.Apellido</td>
                    <td>@est.Matricula</td>
                    <td>@est.Email</td>
                    <td>
                        <button class="btn btn-warning btn-sm me-1" @onclick="() => SeleccionarParaEditar(est)">Editar</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(est.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<EstudianteModel>? lista;
    private EstudianteModel estudianteActual = new();
    private bool modoEdicion = false;
    private string mensajeError = string.Empty;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar() => lista = await EstudianteService.ObtenerEstudiantesAsync();

    private void SeleccionarParaEditar(EstudianteModel est)
    {
        estudianteActual = new EstudianteModel
        {
            Id = est.Id,
            Nombre = est.Nombre,
            Apellido = est.Apellido,
            Matricula = est.Matricula,
            Email = est.Email
        };
        modoEdicion = true;
        mensajeError = string.Empty;
    }

    private void CancelarEdicion()
    {
        estudianteActual = new();
        modoEdicion = false;
        mensajeError = string.Empty;
    }

    private async Task Guardar()
    {
        mensajeError = string.Empty;

        if (string.IsNullOrWhiteSpace(estudianteActual.Nombre) ||
            string.IsNullOrWhiteSpace(estudianteActual.Apellido) ||
            string.IsNullOrWhiteSpace(estudianteActual.Matricula))
        {
            mensajeError = "Nombre, apellido y matrícula son obligatorios.";
            return;
        }

        bool exito = modoEdicion
            ? await EstudianteService.ActualizarEstudianteAsync(estudianteActual)
            : await EstudianteService.CrearEstudianteAsync(estudianteActual);

        if (exito)
        {
            CancelarEdicion();
            await Cargar();
        }
        else
        {
            mensajeError = "No se pudo procesar la solicitud. Revisa la API.";
        }
    }

    private async Task Eliminar(int id)
    {
        if (await EstudianteService.EliminarEstudianteAsync(id))
        {
            if (modoEdicion && estudianteActual.Id == id) CancelarEdicion();
            await Cargar();
        }
    }
}