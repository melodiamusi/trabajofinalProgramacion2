@page "/"

<PageTitle>Dashboard - Sistema de Gestión de Aulas</PageTitle>

<div class="container-fluid px-4 py-4">
    <!-- Hero Banner Premium -->
    <div class="p-4 p-md-5 mb-4 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-light text-primary px-3 py-2 rounded-pill fw-semibold mb-2">Panel Administrativo</span>
                <h1 class="display-6 fw-bold mb-2">Control y Asignación de Espacios</h1>
                <p class="fs-6 text-white-50 mb-4 col-lg-10">
                    Optimiza la disponibilidad de aulas, coordina los horarios académicos y autoriza solicitudes de reserva en tiempo real con cero conflictos.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="reservas" class="btn btn-light text-primary fw-bold px-4 py-2 rounded-3 shadow-sm">
                        Nueva Reserva
                    </a>
                    <a href="aulas" class="btn btn-outline-light px-4 py-2 rounded-3">
                        Ver Disponibilidad
                    </a>
                </div>
            </div>
            <div class="col-lg-4 d-none d-lg-flex justify-content-center">
                <svg width="180" height="180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-white-50">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
            </div>
        </div>
    </div>

    <!-- Sección de Módulos Principales -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-secondary mb-0">Módulos del Sistema</h5>
        <small class="text-muted">Selecciona una sección para gestionar</small>
    </div>

    <div class="row g-4">
        <!-- Tarjeta Reservas -->
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-3 hover-card">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="icon-shape bg-danger bg-opacity-10 text-danger rounded-3 p-3">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        </div>
                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2 py-1">Crítico</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Reservas</h5>
                    <p class="text-muted small flex-grow-1">
                        Control de solicitudes, validación automática de solapamientos y estados.
                    </p>
                    <a href="reservas" class="btn btn-danger w-100 rounded-3 mt-3 fw-semibold">
                        Administrar
                    </a>
                </div>
            </div>
        </div>

        <!-- Tarjeta Aulas -->
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-3 hover-card">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="icon-shape bg-success bg-opacity-10 text-success rounded-3 p-3">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1">Infraestructura</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Aulas</h5>
                    <p class="text-muted small flex-grow-1">
                        Catálogo de recintos físicos, capacidad de estudiantes y recursos.
                    </p>
                    <a href="aulas" class="btn btn-success w-100 rounded-3 mt-3 fw-semibold">
                        Administrar
                    </a>
                </div>
            </div>
        </div>

        <!-- Tarjeta Profesores -->
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-3 hover-card">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        </div>
                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2 py-1">Docencia</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Profesores</h5>
                    <p class="text-muted small flex-grow-1">
                        Registro docente, asignaturas impartidas y correos de contacto.
                    </p>
                    <a href="profesores" class="btn btn-primary w-100 rounded-3 mt-3 fw-semibold">
                        Administrar
                    </a>
                </div>
            </div>
        </div>

        <!-- Tarjeta Cursos -->
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-3 hover-card">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="icon-shape bg-warning bg-opacity-10 text-warning rounded-3 p-3">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                        </div>
                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2 py-1">Academia</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Cursos</h5>
                    <p class="text-muted small flex-grow-1">
                        Planificación curricular, asignación de bloques y secciones.
                    </p>
                    <a href="cursos" class="btn btn-warning text-dark w-100 rounded-3 mt-3 fw-semibold">
                        Administrar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        background-color: #ffffff;
    }

        .hover-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08) !important;
        }

    .icon-shape {
        width: 48px;
        height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
</style>